# App
APP_NAME=Sentry Room
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentry_room

# Files
EVIDENCE_DIR=data/evidence
LEGACY_FACES_DB=data/legacy/faces_db.pkl

# AI face detection
FACE_MATCH_TOLERANCE=0.5
FACE_DETECTION_MODEL=hog
FACE_DETECTION_UPSAMPLE=2

# Alerts
ALERT_EMAIL_TO=security@example.com
APP_ALERT_CHANNEL=mobile_app

# Optional email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true

# OpenAI executive summaries
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
