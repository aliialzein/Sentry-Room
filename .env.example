# App
APP_NAME=Sentry Room
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentry_room

# Files
EVIDENCE_DIR=data/evidence
LEGACY_FACES_DB=data/legacy/faces_db.pkl
FACE_INDEX_PATH=data/face_index/face_index.npz

# Raspberry Pi camera stream receiver
PI_CAMERA_ENABLED=true
PI_CAMERA_TCP_HOST=10.0.0.1
PI_CAMERA_TCP_PORT=9000
PI_CAMERA_MJPEG_FPS=5

# MQTT broker used by the Pi and backend bridge
MQTT_HOST=localhost
MQTT_PORT=1883

# Local Ollama/LLaVA snapshot descriptions
VISION_DESCRIPTION_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
VISION_DESCRIPTION_TIMEOUT_SECONDS=4
VISION_DESCRIPTION_MAX_CHARS=90

# AI face detection
FACE_MATCH_TOLERANCE=0.5
FACE_DETECTION_MODEL=hog
FACE_DETECTION_UPSAMPLE=2
FACE_RECOGNITION_ENABLED=false

# YOLO person detection from the live Pi camera stream
DETECTION_WORKER_ENABLED=true
DETECTION_SAMPLE_INTERVAL_SECONDS=2
YOLO_MODEL_PATH=yolov8n.pt
YOLO_IMAGE_SIZE=416
YOLO_PERSON_CONFIDENCE=0.55
INCIDENT_CLEAR_AFTER_SECONDS=300
IDENTITY_DETECTION_INTERVAL_SECONDS=4

# Alerts
ALERT_EMAIL_TO=security@example.com
APP_ALERT_CHANNEL=mobile_app

# Optional email delivery for alerts and daily entry reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true

# Legacy OpenAI executive summaries, not used by the Gemini summary path
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini alert descriptions, executive summaries, and daily entry report summaries
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_ALERT_TIMEOUT_SECONDS=10
